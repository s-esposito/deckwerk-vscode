{
  "version": "2.0.0",
  "options": {
    "env": {
      // node/npm live in a conda env, not on the system PATH.
      "PATH": "${env:HOME}/.conda/envs/dgmesh/bin:${env:PATH}"
    }
  },
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "problemMatcher": "$esbuild",
      "label": "npm: build",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$esbuild-watch",
      "isBackground": true,
      "label": "npm: watch"
    }
  ]
}
